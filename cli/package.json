{
  "name": "@keymapkit/cli",
  "description": "CLI tools for KeymapKit",
  "author": "Micah R Ledbetter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrled/KeymapKit.git",
    "directory": "cli"
  },
  "version": "1.0.7",
  "private": false,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "type": "module",
  "bin": {
    "keymapkit": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist/cli.js"
  ],
  "scripts": {
    "build": "esbuild --bundle --sourcemap --format=esm --platform=node --outfile=dist/cli.js --banner:js='#!/usr/bin/env node' --external:@keymapkit/models --external:commander --external:\"node:*\" --external:jsdom src/cli.ts && chmod +x dist/cli.js",
    "postbuild": "tsc --project tsconfig.json",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "jsdom": "^31.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@keymapkit/models": "*",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15"
  }
}
